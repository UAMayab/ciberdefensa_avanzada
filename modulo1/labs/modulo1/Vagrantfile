# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# Laboratorio compartido — Módulo I (Anexo A, Sección 7)
# Usado por: A.2 (reconocimiento web y DNS), A.3 (Wireshark/tcpdump),
#            A.4 (Nmap), A.7 (iptables/nftables/UFW), A.8 (Suricata)
#            y como red objetivo para A.6 (pfSense).
# Ver README.md para topología, credenciales de laboratorio y mapeo a cada actividad.

Vagrant.configure("2") do |config|
  # --- dmz-ubuntu: host "rico en servicios" de la DMZ ---
  config.vm.define "dmz-ubuntu" do |dmz|
    dmz.vm.box = "cloud-image/ubuntu-24.04"
    dmz.vm.hostname = "dmz-ubuntu"

    dmz.vm.network "private_network",
      ip: "192.168.56.10",
      virtualbox__intnet: "dmz_net"

    # Red host-only (no intnet): hace el sitio web de la DMZ accesible desde el
    # host en http://192.168.58.10 — ver "Notas técnicas" en README.md.
    dmz.vm.network "private_network",
      ip: "192.168.58.10"

    dmz.vm.provider "virtualbox" do |vb|
      vb.name = "modulo1-dmz-ubuntu"
      vb.memory = 1024
      vb.cpus = 1
    end

    # El sitio web ficticio se sube por SCP (el provisionador "file" no
    # necesita Guest Additions, a diferencia de las carpetas compartidas).
    # Debe declararse ANTES del provisionador shell, que es quien lo instala.
    dmz.vm.provision "file",
      source: "provision/site",
      destination: "/tmp/nordlys-site"

    dmz.vm.provision "shell", path: "provision/dmz-ubuntu.sh"
  end

  # --- int-alpine: host mínimo de la LAN interna ---
  config.vm.define "int-alpine" do |lan|
    lan.vm.box = "generic/alpine319"
    lan.vm.hostname = "int-alpine"

    lan.vm.network "private_network",
      ip: "192.168.57.10",
      virtualbox__intnet: "lan_net"

    lan.vm.provider "virtualbox" do |vb|
      vb.name = "modulo1-int-alpine"
      vb.memory = 256
      vb.cpus = 1
    end

    lan.vm.provision "shell", path: "provision/int-alpine.sh"
  end

  # --- ns-nordlys: DNS autoritativo de nordlysai.dk ---
  # Cierra el único hueco que le faltaba al sitio Nordlys como objetivo de
  # reconocimiento (A.2): sin DNS no hay resolución, ni transferencia de
  # zona, ni espacio de nombres interno que descubrir.
  config.vm.define "ns-nordlys" do |ns|
    ns.vm.box = "generic/alpine319"
    ns.vm.hostname = "ns-nordlys"

    ns.vm.network "private_network",
      ip: "192.168.56.20",
      virtualbox__intnet: "dmz_net"

    # Red host-only: permite consultar el DNS desde el host (dig @192.168.58.20)
    # sin necesidad de Kali, igual que el sitio web en 192.168.58.10.
    ns.vm.network "private_network",
      ip: "192.168.58.20"

    ns.vm.provider "virtualbox" do |vb|
      vb.name = "modulo1-ns-nordlys"
      vb.memory = 256
      vb.cpus = 1
    end

    # Zonas y named.conf por SCP, igual que el sitio web de dmz-ubuntu.
    # Debe declararse ANTES del provisionador shell, que es quien las instala.
    ns.vm.provision "file",
      source: "provision/dns",
      destination: "/tmp/nordlys-dns"

    ns.vm.provision "shell", path: "provision/ns-nordlys.sh"
  end
end
